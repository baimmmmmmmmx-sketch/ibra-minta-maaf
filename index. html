<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title id="title-tag">Ibra Minta Maaf Ya... 🤍</title>
    <style>
        :root {
            --bg-start: #ffc0cb;
            --bg-end: #ffb6c1;
            --btn-bg: #ff6b6b;
            --btn-hover: #ff8787;
            --text-color: #ff4757;
        }

        body {
            margin: 0;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, var(--bg-start), var(--bg-end));
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--text-color);
            text-align: center;
            overflow-x: hidden;
        }

        .card {
            background: rgba(255, 255, 255, 0.9);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            max-width: 400px;
            width: 100%;
            position: relative;
            z-index: 10;
        }

        h1, h2 {
            margin-bottom: 20px;
        }

        .btn {
            background-color: var(--btn-bg);
            color: white;
            border: none;
            padding: 12px 24px;
            margin: 10px 5px;
            border-radius: 25px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn:hover {
            background-color: var(--btn-hover);
            transform: scale(1.05);
        }

        .music-btn {
            position: fixed;
            top: 15px;
            right: 15px;
            z-index: 100;
            border-radius: 50px;
            padding: 8px 16px;
            font-size: 14px;
        }

        .hidden {
            display: none;
        }

        .secret-msg {
            font-style: italic;
            font-size: 0.9em;
            margin-top: 15px;
            color: #666;
        }
    </style>
</head>
<body>

    <!-- Tombol Pemutar Musik -->
    <button id="music-btn" class="btn music-btn">🎵 Putar Musik</button>
    <audio id="bg-music" loop></audio>

    <!-- Kontainer Utama Aplikasi -->
    <div class="card">
        <!-- Pertanyaan 1 -->
        <div id="q1-step">
            <h2 id="q1-text"></h2>
            <button id="q1-yes" class="btn"></button>
            <button id="q1-no" class="btn"></button>
            <p id="secret-ans" class="secret-msg hidden"></p>
        </div>

        <!-- Pertanyaan 2 -->
        <div id="q2-step" class="hidden">
            <h2 id="q2-text"></h2>
            <p id="q2-start"></p>
            <button id="q2-next" class="btn"></button>
        </div>

        <!-- Pertanyaan 3 -->
        <div id="q3-step" class="hidden">
            <h2 id="q3-text"></h2>
            <button id="q3-yes" class="btn"></button>
            <button id="q3-no" class="btn"></button>
        </div>

        <!-- Tampilan Perayaan/Selesai -->
        <div id="celeb-step" class="hidden">
            <h1 id="celeb-title"></h1>
            <p id="celeb-msg"></p>
            <div id="celeb-emojis" style="font-size: 2rem;"></div>
            <p id="love-msg" style="margin-top: 15px; font-weight: bold;"></p>
        </div>
    </div>

    <!-- Menghubungkan File JS Kamu -->
    <script src="script.js"></script>

    <!-- Script Pendukung Integrasi Variabel CONFIG -->
    <script>
        // Mengisi teks dari object CONFIG ke HTML
        if (typeof CONFIG !== 'undefined') {
            document.getElementById('title-tag').innerText = CONFIG.pageTitle;
            
            // Audio setup
            const audio = document.getElementById('bg-music');
            const musicBtn = document.getElementById('music-btn');
            audio.src = CONFIG.music.musicUrl;
            audio.volume = CONFIG.music.volume;

            musicBtn.addEventListener('click', () => {
                if (audio.paused) {
                    audio.play();
                    musicBtn.innerText = CONFIG.music.stopText;
                } else {
                    audio.pause();
                    musicBtn.innerText = CONFIG.music.startText;
                }
            });

            // Q1
            document.getElementById('q1-text').innerText = CONFIG.questions.first.text;
            document.getElementById('q1-yes').innerText = CONFIG.questions.first.yesBtn;
            document.getElementById('q1-no').innerText = CONFIG.questions.first.noBtn;
            document.getElementById('secret-ans').innerText = CONFIG.questions.first.secretAnswer;

            // Q2
            document.getElementById('q2-text').innerText = CONFIG.questions.second.text;
            document.getElementById('q2-start').innerText = CONFIG.questions.second.startText;
            document.getElementById('q2-next').innerText = CONFIG.questions.second.nextBtn;

            // Q3
            document.getElementById('q3-text').innerText = CONFIG.questions.third.text;
            document.getElementById('q3-yes').innerText = CONFIG.questions.third.yesBtn;
            document.getElementById('q3-no').innerText = CONFIG.questions.third.noBtn;

            // Celebration
            document.getElementById('celeb-title').innerText = CONFIG.celebration.title;
            document.getElementById('celeb-msg').innerText = CONFIG.celebration.message;
            document.getElementById('celeb-emojis').innerText = CONFIG.celebration.emojis;
        }
    </script>
</body>
</html>
